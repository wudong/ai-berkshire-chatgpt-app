{
  "name": "ai-berkshire-chatgpt-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "rm -rf dist web/dist && bun run build:widget && bun build src/main.ts --target=bun --outdir dist --sourcemap=external",
    "build:widget": "mkdir -p web/dist && bun build web/widget.tsx --target=browser --format=esm --outfile=web/dist/widget.js --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "start": "bun run src/main.ts",
    "auth:migrate": "bun x --bun auth migrate --config src/auth/migrate.ts --yes",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.0-rc.2",
    "@modelcontextprotocol/server": "2.0.0",
    "auth": "1.7.0-rc.2",
    "better-auth": "1.7.0-rc.2",
    "decimal.js": "10.6.0",
    "hono": "^4.9.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  }
}
